{
  "name": "yorr",
  "private": true,
  "type": "module",
  "description": "저장소 공통 개발 도구 (프로덕트 코드는 backend/ · frontend/)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "hooks:install": "git config core.hooksPath .githooks",
    "check:tokens": "node tools/check-file-tokens.mjs --all",
    "check:loc": "node tools/check-loc-ratchet.mjs",
    "check:tokens:staged": "node tools/check-file-tokens.mjs",
    "check:quality": "node tools/check-code-quality.mjs",
    "check:quality:report": "node tools/check-code-quality.mjs --report",
    "test:quality": "node --test tools/qualityScanner.test.mjs tools/check-code-quality.test.mjs"
  },
  "devDependencies": {
    "js-tiktoken": "^1.0.21"
  }
}
