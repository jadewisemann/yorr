{
  "name": "yorr-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:real": "cross-env VITE_ENABLE_MSW=false VITE_WS_URL=/ws/v1/game vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "bake:hero": "node scripts/bake-hero.mjs",
    "test:e2e:real": "cross-env VITE_WS_URL=/ws/v1/game npm run build && cross-env E2E_TARGET=real playwright test",
    "check:cycles": "dpdm --circular --exit-code circular:1 --no-warning --no-tree --no-progress \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@tanstack/react-router": "^1.170.45",
    "clsx": "^2.1.1",
    "motion": "^12.43.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "0.186.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "dpdm": "^4.3.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
