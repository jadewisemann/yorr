{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!coverage",
      "!playwright-report",
      "!test-results",
      "!ref",
      "!docs",
      "!design_handoff_yorr_landing",
      "!public/mockServiceWorker.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "lineEnding": "crlf",
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noImportantStyles": "off",
        "noExcessiveCognitiveComplexity": "warn"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.{ts,tsx}"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/**",
        "!src/app/dev/**",
        "!src/duel/**",
        "!src/landing/**",
        "!src/pingpong/**",
        "!src/yacht/**",
        "!**/__tests__/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/duel/model/**",
                      "@/landing/rendering/**",
                      "@/pingpong/model/**",
                      "@/pingpong/rendering/**",
                      "@/yacht/rendering/**"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/duel/**", "!**/__tests__/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/landing/rendering/**",
                      "@/pingpong/model/**",
                      "@/pingpong/rendering/**",
                      "@/yacht/rendering/**"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/landing/**", "!**/__tests__/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/duel/model/**",
                      "@/pingpong/model/**",
                      "@/pingpong/rendering/**",
                      "@/yacht/rendering/**"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/pingpong/**", "!**/__tests__/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/duel/model/**", "@/landing/rendering/**", "@/yacht/rendering/**"]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/yacht/**", "!**/__tests__/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/duel/model/**",
                      "@/landing/rendering/**",
                      "@/pingpong/model/**",
                      "@/pingpong/rendering/**"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
