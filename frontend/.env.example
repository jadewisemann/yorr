VITE_API_BASE_URL=/api/v1
VITE_WS_URL=ws://localhost:8080/ws/v1/game
# MSW 모드: true = 전부 mock / fallback = 실서버 우선, 서버에 없는 API 만 mock / false = MSW 끔(전부 실서버)
VITE_ENABLE_MSW=true

# --- 실서버 모드: MSW 끄고 vite proxy 로 백엔드 직결 (npm run dev:real) ---
# 기본 대상은 배포 dev 서버(https://i15a406.p.ssafy.io, /dev-api·/dev-ws rewrite 자동 적용).
# 테스트가 만든 방이 공용 dev 서버에 남는다 — 대량 실행 전 팀에 공유.
# VITE_ENABLE_MSW=false
# VITE_WS_URL=/ws/v1/game            # 상대경로면 same-origin proxy 를 탄다 (realtimeClient 가 해석)
# 로컬 백엔드를 쓰려면:
# VITE_BACKEND_ORIGIN=http://localhost:8080

# --- 운영(Vercel) 값: 이 파일이 아니라 Vercel/Jenkins 자격증명에 넣는다 ---
# 프론트는 https://yorr.site 에서, 백엔드는 다른 출처(api.yorr.site 또는 공인 IP)에서
# 돈다. vercel.json에는 /api 프록시가 없으므로 **절대 URL이어야 한다** — 그래서
# 백엔드의 CORS_ALLOWED_ORIGINS에 https://yorr.site 가 들어 있어야 한다.
#
# ⚠️ HTTPS 페이지에서 ws:// 는 브라우저가 mixed content로 차단한다 — WS는 wss://.
#    (상대경로 `/ws/v1/game`도 가능하다 — realtimeClient가 페이지 스킴을 따라
#     wss로 올려 준다. 단 Vercel rewrite는 WS를 프록시하지 못하므로 실제로는
#     백엔드를 same-origin으로 노출한 경우에만 쓸 수 있다.)
# VITE_API_BASE_URL=https://api.yorr.site/api/v1
# VITE_WS_URL=wss://api.yorr.site/ws/v1/game
# VITE_ENABLE_MSW=false
