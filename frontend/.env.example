VITE_API_BASE_URL=/api/v1
VITE_WS_URL=ws://localhost:8080/ws/v1/game
# MSW 모드: true = 전부 mock / fallback = 실서버 우선, 서버에 없는 API 만 mock / false = MSW 끔(전부 실서버)
VITE_ENABLE_MSW=true
# false·fallback 일 때 붙을 서버. remote(기본)=배포된 dev 서버, local=내 PC 의 backend(localhost:8080).
# local 로 둘 때는 VITE_WS_URL 도 localhost 를 가리키게 맞춘다.
VITE_API_TARGET=remote
