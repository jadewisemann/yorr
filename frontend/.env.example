VITE_API_BASE_URL=/api/v1
VITE_WS_URL=ws://localhost:8080/ws/v1/game
# MSW 모드: true = 전부 mock / fallback = 실서버 우선, 서버에 없는 API 만 mock / false = MSW 끔(전부 실서버)
VITE_ENABLE_MSW=true

# --- 실서버 모드: MSW 끄고 vite proxy 로 백엔드 직결 (npm run dev:real) ---
# 기본 대상은 배포 dev 서버(https://i15a406.p.ssafy.io, /dev-api·/dev-ws rewrite 자동 적용).
# 테스트가 만든 방이 공용 dev 서버에 남는다 — 대량 실행 전 팀에 공유.
# VITE_ENABLE_MSW=false
# VITE_WS_URL=/ws/v1/game            # 상대경로면 same-origin proxy 를 탄다 (realtimeClient 가 해석)
# 로컬 백엔드를 쓰려면:
# VITE_BACKEND_ORIGIN=http://localhost:8080
