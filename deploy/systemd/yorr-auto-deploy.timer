# 5분마다 "바뀐 게 있나 · 게임이 없나"를 본다.
#
# 주기를 짧게 잡아도 비싸지 않다: 바뀐 것이 없으면 `git pull` + `docker compose pull`
# 두 번의 왕복으로 끝나고 로그도 남기지 않는다. 대신 **게임이 끝나는 순간을 놓치지
# 않는 것**이 이 방식의 값어치라, 주기가 곧 "배포가 밀리는 최대 시간"이다.
[Unit]
Description=YORR 자동 배포 타이머

[Timer]
OnBootSec=5min
OnUnitActiveSec=5min
# 여러 타이머가 같은 초에 몰리는 것을 흩는다.
RandomizedDelaySec=60
Unit=yorr-auto-deploy.service

[Install]
WantedBy=timers.target
