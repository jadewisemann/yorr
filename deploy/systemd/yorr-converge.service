# YORR 릴리스 수렴 — 한 번 판단하고 끝나는 oneshot. 주기는 타이머가 정한다.
#
# ⚠️ 이 파일은 **템플릿이다.** `@USER@`를 손으로 고치지 말고 설치 스크립트를 쓴다:
#
#   deploy/bootstrap.sh
#
# 손으로 고치면 안 되는 이유가 이 저장소의 실제 사고 원인일 가능성이 크다: 이 파일은
# **git 추적 파일**이고, 예전 문서가 "호스트 계정에 맞춰 고쳐라"라고 지시했다. 그대로
# 따르면 `git pull --ff-only`가 영구히 막히고, 세 배포 경로가 그 한 줄을 공유하므로
# **동시에 죽는다**(deploy/PLAN.md §4 가설 1).
#
# 호스트별 값은 git이 모르는 곳에 있다: /etc/default/yorr-deploy.
#
# 보기:  journalctl -u yorr-converge -f
# 멈춤:  sudo systemctl disable --now yorr-converge.timer

[Unit]
Description=YORR 릴리스 수렴 (Release 단위 pull-based CD)
# 부팅 직후 도커가 준비되기 전에 돌면 발견·pull이 실패한다.
After=docker.service network-online.target
Wants=docker.service

[Service]
Type=oneshot
User=@USER@
# 체크아웃 위치·이미지 저장소·알림 주소가 여기 있다. `-` 접두사는 파일이 없어도
# 유닛이 실패하지 않게 한다(그때는 controller의 기본값이 쓰인다).
EnvironmentFile=-/etc/default/yorr-deploy
ExecStart=/usr/local/lib/yorr-deploy/converge
# systemd가 /var/lib/yorr-deploy를 이 User 소유로 만들어 준다 — last-good·halted·lock이
# 여기 산다. 손 실행도 같은 디렉터리를 보므로 bootstrap이 미리 만들어 둔다.
StateDirectory=yorr-deploy
# 이미지 pull + `up -d --wait`(기본 150초) + 실패 시 롤백까지 한 번에 들어간다.
TimeoutStartSec=900
