          "legendFormat": "available"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "디스크 사용률",
      "description": "가장 많이 찬 파일시스템을 본다. preflight는 여유 10% 미만이면 배포를 막는다 — 즉 90%를 넘기면 배포가 멈춘다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2,
            "showPoints": "never",
            "gradientMode": "opacity"
          },
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max(100 * (1 - node_filesystem_avail_bytes{fstype!=\"\"} / node_filesystem_size_bytes{fstype!=\"\"}))",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "최대 사용률"
        }
      ]
    },
