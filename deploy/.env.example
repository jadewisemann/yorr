# YORR 단일 호스트 스택 — 운영자가 관리하는 설정 파일 하나의 예시.
#
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
#
# compose가 자기 파일 옆의 `.env`를 **보간(${...})** 과 `backend`의 `env_file`에
# 모두 쓴다(deploy/compose.yaml 머리 주석). 즉 이 파일 하나가 Caddy·MySQL·백엔드의
# 설정을 동시에 담는다. 루트 `.gitignore`가 `.env`를 무시하므로 실제 값은 커밋되지
# 않는다 — 이 예시 파일만 저장소에 남는다.
#
# 변수의 의미·기본값 정본은 `backend/src/config/env.ts`(zod 스킴)와
# `backend/docs/design/operations.md`의 표다. 여기 값은 **운영(https://yorr.site)**
# 기준으로 채워 두었다.
#
# ⚠️ 이 파일에 손으로 채우는 것은 **비밀과 이 호스트만의 값**뿐이다:
# `PUBLIC_HOST` · DB·Redis 비밀번호 · 소셜 자격 네 개. 공개 주소(CORS 목록·콜백
# 세 개)는 `compose.yaml`이 기본값으로 갖고 있다 — 아래 「공개 주소 4개」 참고.

# ── 공개 주소 (Caddy) ─────────────────────────────────────────────────────────
# Caddy 사이트 주소이자 인증서 대상. 둘 중 하나를 쓴다:
#   1) OCI 공인 IP 리터럴 — DNS 없이 바로 뜬다. 인증서 SAN이 IP Address가 되고
#      Let's Encrypt `shortlived` profile이 필수다(deploy/Caddyfile).
#   2) 백엔드용 DNS 이름 — A/AAAA를 이 인스턴스로 먼저 붙여야 한다(HTTP-01 검증이
#      그것에 걸려 있다). **지금 그런 이름은 없다.** 소셜 로그인 때문에 필요하지도
#      않다: 콜백은 프론트 도메인으로 받고 vercel.json의 rewrite가 넘긴다(#40).
# 바꾸면 프론트의 VITE_API_BASE_URL·VITE_WS_URL도 같이 바꿔야 한다.
#
# ⚠️ **비워 둔 채로 두었다.** 예전에는 여기에 그럴듯한 예시 값이 박혀 있었는데,
#    이 파일이 스스로 "손으로 채우는 것은 비밀과 이 호스트만의 값뿐"이라고 적은
#    자리라 그 값이 실제 주소로 읽혔다. 비워 두면 `${PUBLIC_HOST:?}`(compose.yaml)가
#    `docker compose config`에서 바로 걸린다 — 조용히 틀린 주소로 뜨는 것보다 낫다.
#    실제 공인 IP를 여기 적는 것도 피했다: 그 IP는 ephemeral이고 이미 세 곳에
#    박혀 있다(deploy/PLAN.md §12). 네 번째 자리를 만들지 않는다.
PUBLIC_HOST=
SERVER_PORT=8080

# ── 공개 주소 4개는 이 파일에 쓰지 않는다 ────────────────────────────────────
# `CORS_ALLOWED_ORIGINS` · `AUTH_FRONTEND_REDIRECT_URI` · `KAKAO_REDIRECT_URI` ·
# `GOOGLE_REDIRECT_URI`의 운영 값은 **`compose.yaml`이 기본값으로 갖고 있다**
# (`${VAR:-...}`). 비밀이 아니라 "우리가 어느 주소로 서비스하는가"이므로 저장소가
# 정본을 갖는 편이 안전하다 — 호스트에서 손으로 옮겨 적다 틀리는 일이 없어진다.
# 그래서 도메인이 바뀌면 **호스트에서 할 일은 `git pull` + `up -d backend`뿐이다.**
#
# 아래 네 줄은 주석으로 둔다. **주석을 풀면 그 값이 compose 기본값을 이긴다**
# (빈 값 `KEY=`는 이기지 않는다 — 그때는 compose 기본값이 그대로 쓰인다).
# 일시적으로 한 호스트만 다르게 띄울 때만 쓰고, 영구 변경은 `compose.yaml`에서 한다.
#
# CORS: 브라우저에서 이 서버를 부를 수 있는 출처. **정확 일치**이고 패턴이 아니다
# (ws/gateway.ts의 `originAllowed`). 끝의 `/`는 코드가 떼 준다. www를 별도로
# 서비스하면 `https://www.yorr.site`도 더한다(Vercel에서 301이면 필요 없다).
# Vercel Preview는 매번 다른 출처(`yorr-<해시>.vercel.app`)라 목록으로 열 수 없다.
# 이 목록은 **소셜 로그인의 복귀 출처**도 겸한다: 여기 있는 출처에서 로그인하면
# 그 출처로 돌아온다(없는 출처는 AUTH_FRONTEND_REDIRECT_URI로). DNS가 아직 안
# 붙은 주소에서 로그인을 시험할 때 손댈 곳이 이 목록 하나다 — 제공자 콘솔은
# 그대로다(backend/docs/design/auth.md 「복귀 출처」).
# CORS_ALLOWED_ORIGINS=https://yorr.site,https://yorr-eight.vercel.app

# ── MySQL (계정·전적·랭킹) ────────────────────────────────────────────────────
# 좌표(호스트·포트)는 compose가 정한다 — 여기서는 자격과 이름만 준다.
# ⚠️ DB_URL은 비워 둔다. 값이 있으면 env.ts가 DB_HOST를 덮어써 컨테이너가 옆
#    서비스를 못 찾는다(구 SSAFY 호스트의 `.env`를 그대로 가져올 때 밟는 지점).
DB_URL=
DB_NAME=yorr
DB_USERNAME=yorr
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 일일 논리 백업. `${BACKUP_DIR}`을 호스트 밖으로 복사하는 것까지가 백업이다.
BACKUP_DIR=./backup
BACKUP_RETENTION_DAYS=14

# ── Redis (방·세션·진행 중 게임 상태) ────────────────────────────────────────
# 좌표는 compose가 정한다. 비밀번호를 쓰면 여기에.
REDIS_PASSWORD=

# ── 소셜 로그인 ───────────────────────────────────────────────────────────────
# **여기에 채울 것은 클라이언트 자격 네 개뿐이다** — 주소 세 개는 compose에 있다
# (위 「공개 주소 4개」). 자격을 비워 두면 서버는 뜨고 로그인 엔드포인트만
# 거절한다(not_configured).
#
# KAKAO_CLIENT_ID는 REST API 키다(JavaScript 키가 아니다 — 토큰 교환은 서버가 한다).
# KAKAO_CLIENT_SECRET은 선택이고, 콘솔에서 "사용함"으로 바꿔야 적용된다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 참고 — 제공자 콘솔에 등록하는 값(compose 기본값과 문자 하나까지 같아야 한다.
# 카카오는 다르면 KOE006):
#   카카오 Redirect URI  https://yorr.site/api/v1/auth/kakao/callback
#   구글  Redirect URI  https://yorr.site/api/v1/auth/google/callback
# 백엔드가 아니라 **프론트 도메인**인 것은 콘솔이 IP를 받지 않기 때문이다 —
# `frontend/vercel.json`의 rewrite가 그 두 경로만 백엔드로 넘긴다. 덕분에 백엔드
# 주소(PUBLIC_HOST)를 바꿔도 콘솔 등록값은 그대로다(vercel.json만 고친다).
# 카카오는 이것과 별개로 「플랫폼 > Web > 사이트 도메인」에 https://yorr.site 를 등록해야 한다.
#
# 로그인을 끝낸 사용자를 되돌려 보낼 프론트 주소는 AUTH_FRONTEND_REDIRECT_URI
# (= https://yorr.site/auth/callback, compose 기본값)다. 프론트 도메인을 바꾸면
# 이것도 바꿔야 한다 — 안 바꾸면 로그인 후 옛 주소로 튕기고, 세션이 그 origin의
# localStorage에 저장돼 새 도메인에서는 로그아웃 상태로 보인다.
# AUTH_FRONTEND_REDIRECT_URI=https://yorr.site/auth/callback
# KAKAO_REDIRECT_URI=https://yorr.site/api/v1/auth/kakao/callback
# GOOGLE_REDIRECT_URI=https://yorr.site/api/v1/auth/google/callback

# ── 음성 (WebRTC ICE) ─────────────────────────────────────────────────────────
# coturn을 배포하지 않으므로 STUN-only다 — TURN 두 값을 비워 두면 코드가 그 모드로 간다.
YORR_VOICE_TURN_SECRET=
YORR_VOICE_TURN_HOST=
YORR_VOICE_STUN_URL=stun:stun.l.google.com:19302

# ── 이미지·컨테이너 이름 (기본값으로 충분하다) ───────────────────────────────
# 롤백은 BACKEND_IMAGE를 `:sha-<커밋>`으로 바꿔 `up -d backend`.
# BACKEND_IMAGE=ghcr.io/jadewisemann/yorr-backend:main
