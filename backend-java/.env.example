DB_URL=jdbc:mysql://localhost:3306/yorr?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

SERVER_PORT=8080

# === CORS ===
# 브라우저에서 이 서버를 부를 수 있는 출처(쉼표로 구분). REST와 WebSocket이 같은 값을 쓴다.
# 비워두면 운영 도메인(https://yorr.site)만 열린다 — 로컬 개발에는 아래처럼 localhost를 더한다.
CORS_ALLOWED_ORIGINS=https://yorr.site,http://localhost:5173,http://127.0.0.1:5173

# === 카카오 소셜 로그인 ===
# 없어도 서버는 뜬다(로그인 엔드포인트만 503). 로그인을 만질 때만 채우면 된다.
# KAKAO_CLIENT_ID 는 앱 키 중 REST API 키다(JavaScript 키가 아니다 — 토큰 교환은 서버가 한다).
# KAKAO_CLIENT_SECRET 은 콘솔에서 발급한 뒤 상태를 "사용함"으로 바꿔야 적용된다.
# KAKAO_REDIRECT_URI 는 콘솔에 등록한 값과 문자 하나까지 같아야 한다(다르면 KOE006).
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/api/v1/auth/kakao/callback

# 로그인을 끝낸 사용자를 되돌려 보낼 프론트 주소. 카카오 콘솔에 등록하는 값이 아니다.
AUTH_FRONTEND_REDIRECT_URI=http://localhost:5173/auth/callback

# === 구글 소셜 로그인 ===
# Google Cloud Console에서 "웹 애플리케이션" OAuth 클라이언트를 만든다.
# 승인된 리디렉션 URI에는 아래 값과 문자 하나까지 같은 주소를 등록해야 한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
