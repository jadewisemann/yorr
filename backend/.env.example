# === 서버 ===
SERVER_PORT=8080

# === CORS ===
# 브라우저에서 이 서버를 부를 수 있는 출처 (콤마 구분). REST와 WebSocket이 같은 값을 쓴다.
# 기본값은 운영 도메인만이다 — 로컬 개발자는 localhost를 덧붙인다.
CORS_ALLOWED_ORIGINS=https://yorr.site,http://localhost:5173

# === Redis (방·세션·게임 상태) ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# === MySQL (계정·전적·랭킹) ===
DB_HOST=localhost
DB_PORT=3306
DB_NAME=yorr
DB_USERNAME=yorr
DB_PASSWORD=
