# === 서버 ===
SERVER_PORT=8080

# === CORS ===
# 브라우저에서 이 서버를 부를 수 있는 출처 (콤마 구분). REST와 WebSocket이 같은 값을 쓴다.
# 기본값은 운영 도메인만이다 — 로컬 개발자는 localhost를 덧붙인다.
CORS_ALLOWED_ORIGINS=https://yorr.site,http://localhost:5173

# === Redis (방·세션·게임 상태) ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# === MySQL (계정·전적·랭킹) ===
# 운영 `.env`는 backend-java와 공용이라 JDBC URL 하나(DB_URL)로 온다.
# DB_URL이 있으면 아래 DB_HOST·DB_PORT·DB_NAME을 덮어쓴다(쿼리 파라미터는 무시 —
# serverTimezone을 따르면 마이그레이션 4.1이 못박은 UTC 계약이 깨진다).
# DB_URL=jdbc:mysql://localhost:3306/yorr?useSSL=false&characterEncoding=UTF-8
DB_HOST=localhost
DB_PORT=3306
DB_NAME=yorr
DB_USERNAME=yorr
DB_PASSWORD=

# === 소셜 로그인 (없어도 서버는 뜬다 — 로그인 엔드포인트만 503) ===
# 이름·기본값은 backend-java `application.yaml`의 yorr.auth.* 그대로다.
# 로그인을 끝낸 사용자를 되돌려 보낼 프론트 주소(제공자 콘솔에 등록하는 값이 아니다).
AUTH_FRONTEND_REDIRECT_URI=http://localhost:5173/auth/callback
# KAKAO_CLIENT_ID는 REST API 키다(JavaScript 키가 아니다 — 토큰 교환은 서버가 한다).
# KAKAO_CLIENT_SECRET은 선택이고, 콘솔에서 "사용함"으로 바꿔야 적용된다.
# KAKAO_REDIRECT_URI는 콘솔 등록값과 문자 하나까지 같아야 한다(다르면 KOE006).
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/api/v1/auth/kakao/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
