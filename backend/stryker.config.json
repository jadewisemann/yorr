{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "QUALITY.md 5단계. 전 범위를 대상으로 삼으면 한 번 실행에 수 시간이 걸려 CI에서 쓸 수 없으므로, 외부 의존이 없는 순수 로직 모듈부터 범위를 넓혀 간다.",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "reporters": [
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": "../tools/quality/.stryker.json"
  },
  "coverageAnalysis": "perTest",
  "timeoutMS": 60000,
  "concurrency": 2,
  "mutate": [
    "src/game/score/scoreCategory.ts",
    "src/game/score/scoreBoard.ts",
    "src/game/score/yachtScoreCalculator.ts",
    "src/game/ranking/weekBoundary.ts",
    "src/game/ranking/weeklyRankingResponse.ts",
    "src/game/completion/gameResultCalculator.ts"
  ],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": null
  },
  "tsconfigFile": ""
}
